  m_Script: {fileID: 11500000, guid: e73104189ae6b4c448e5b7802ecd4483, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  image: {fileID: 741812141}
  textComponent: {fileID: 1382597802}
  textSpeed: 0.07
  dialogueLines:
  - line: Wow okay.. That cave ahead looks a little spooky.
    characterDialogueBox: {fileID: 6345877533020809284, guid: 4a0da7a1d65157e418d9f02d6b33ce03, type: 3}
  - line: I don't know if I'll even fit in there...
    characterDialogueBox: {fileID: 5392214278869696427, guid: e4955e0569eb60045a6cca06f2de1c00, type: 3}
  - line: Ruff!
    characterDialogueBox: {fileID: 3098246571187038869, guid: e78a57a063c7895448b0e807829aa3d6, type: 3}
  - line: I am NOT scared!
    characterDialogueBox: {fileID: 6345877533020809284, guid: 4a0da7a1d65157e418d9f02d6b33ce03, type: 3}
  - line: I have an idea, I go through this small looking...
    characterDialogueBox: {fileID: 5392214278869696427, guid: e4955e0569eb60045a6cca06f2de1c00, type: 3}
  - line: ...water tunnel, and you go in that horrifying cave!
    characterDialogueBox: {fileID: 5392214278869696427, guid: e4955e0569eb60045a6cca06f2de1c00, type: 3}
  - line: ...Huff
    characterDialogueBox: {fileID: 8495583623763930966, guid: a32271d48158db146b2a5c7365fa3472, type: 3}
  - line: Yay! Deal!
    characterDialogueBox: {fileID: 7230102730091871856, guid: 55356a3f99944854ba7db34f24cdc674, type: 3}
  level01: 0
  level02: 1
  level02_underwater: 0
  level03: 0
